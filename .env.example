# Copie para .env e preencha. Nada aqui é obrigatório para o site rodar.
# O mesmo arquivo serve para rodar local (npm start) e no Docker (--env-file .env).

# --- IA (Claude) ---
# Sem chave, o site roda em modo rascunho: mostra o título original da fonte.
# Chave própria do app (recomendada): usada no lugar das variáveis ANTHROPIC_* da máquina.
PLATOMAI_ANTHROPIC_API_KEY=
# PLATOMAI_ANTHROPIC_URL=https://api.anthropic.com
# Alternativa: a variável padrão do SDK.
ANTHROPIC_API_KEY=
# 1 força a IA ligada sem ANTHROPIC_API_KEY nem ANTHROPIC_AUTH_TOKEN (ex.: perfil do `ant auth login`); 0 desliga mesmo com chave.
# AI_ENABLED=1
# Modelo e esforço. Padrão: claude-opus-5-5 com esforço low (rápido).
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_CONCURRENCY=3
# Linha editorial lida pela IA antes de cada manchete (no Docker, monte a pasta editorial/; veja o README).
# EDITORIAL_PATH=editorial/linha-editorial.md

# --- PlatomAI decifra (análise das notícias oficiais; precisa da IA ligada) ---
# Liga com a IA. "revisao" (padrão): cada texto espera um clique em /revisao. "automatica": texto que passa em
# todas as checagens vai direto ao site; os que falham continuam esperando revisão.
# DECIFRA=1
# DECIFRA_PUBLICACAO=revisao
# DECIFRA_MODELO=claude-opus-5-5
# DECIFRA_ESFORCO=medium
# DECIFRA_CONCORRENCIA=2
# Fontes que recebem decifra, por prefixo do id (bcb, fed, ecb, ibge, sidra, cvm ou ids como bcb-copom).
# DECIFRA_FONTES=bcb,fed,ecb,ibge,sidra,cvm
# Fatos relevantes só recebem decifra a partir desta urgência, dada pelo redator conforme a linha editorial (normal|alta|urgente).
# DECIFRA_CVM_URGENCIA=alta
# DECIFRA_PROMPT=editorial/agente-analise.md

# --- Imprensa (título do veículo + crédito + link; sem IA, sem redes) ---
# Padrão: agenciabrasil,infomoney,poder360,g1,moneytimes. "folha" existe, mas fica desligada (os termos pedem
# autorização). "nenhuma" desliga todas.
# IMPRENSA_FONTES=agenciabrasil,infomoney,poder360,g1,moneytimes
# IMPRENSA_INTERVALO_S=60

# --- Alpha Vantage (notícias de mercado; a PlatomAI já assina) ---
# Sem chave, a fonte fica desligada. A licença padrão da Alpha Vantage é pessoal e não comercial:
# "interno" (padrão) só mostra as notícias na página privada /revisao; "publico" vira manchete e exige
# o acordo comercial por escrito da Alpha Vantage (premium@alphavantage.co).
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_USO=interno
# Consultas separadas por vírgula: topics:<tema> ou tickers:<código>. Cada uma é uma requisição por ciclo.
# ALPHAVANTAGE_CONSULTAS=topics:economy_monetary,topics:economy_macro,topics:economy_fiscal,tickers:PBR,tickers:VALE,tickers:ITUB,tickers:BBD,tickers:NU,tickers:XP,tickers:ERJ,tickers:SBS
# ALPHAVANTAGE_INTERVALO_S=120
# Relevância mínima (0 a 1) da notícia para o tema ou ativo da consulta.
# ALPHAVANTAGE_RELEVANCIA_MIN=0.8

# --- CVM: fatos relevantes (fonte oficial e gratuita; ligada por padrão) ---
# CVM_FATOS=1
# CVM_INTERVALO_S=30

# --- Partnr (notícias do mercado brasileiro; em teste) ---
# Sem chave, a fonte fica desligada. "interno" (padrão) só mostra as notícias na página privada /revisao;
# "publico" exige o contrato por escrito cobrindo site e redes, e cada notícia precisa trazer veículo e link.
PARTNR_API_KEY=
PARTNR_USO=interno
# PARTNR_INTERVALO_S=15
# PARTNR_RELEVANCIA_MIN=0.5
# PARTNR_URL=https://data.partnr.ai/v2

# --- Página privada de revisão (/revisao) ---
# Token longo e aleatório (ex.: openssl rand -hex 24). Sem token, a página não mostra dados.
# Para entrar direto: https://<site>/revisao#t=<token> (o token não vai para o servidor pela URL).
REVIEW_TOKEN=

# --- Redes sociais (sem credencial = simulação no log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social
# Menor urgência enviada às redes: normal | alta | urgente
SOCIAL_MIN_URGENCY=alta

# --- Site ---
# Endereço público, sem barra no fim. No ar, use o https do site: é o link do Telegram, do Bluesky e do RSS.
SITE_URL=http://localhost:8080
# Só para rodar fora do Docker. A imagem já usa porta 8080, 0.0.0.0 e o banco em /data/aovivo.db (o volume);
# definir estes valores no .env do Docker tira o banco do volume ou deixa o site fora do ar.
# PORT=8080
# HOST=0.0.0.0
# DB_PATH=data/aovivo.db
# 1 = mostra no site as manchetes que caíram na checagem automática (para avaliar a IA)
SHOW_REVIEW=0
# Multiplica os intervalos de consulta às fontes (0.5 = 2x mais rápido)
POLL_SCALE=1
BACKFILL_PER_SOURCE=3
# Conexões ao vivo (SSE) aceitas no total e por IP; 0 no limite por IP desliga esse limite.
# SSE_MAX_CLIENTS=2000
# SSE_MAX_PER_IP=20
