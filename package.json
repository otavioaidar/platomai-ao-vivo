{
  "name": "platomai-ao-vivo",
  "version": "0.1.0",
  "private": true,
  "description": "PlatomAI Ao Vivo: notícias rápidas do mercado, escritas por IA a partir de fontes oficiais.",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --disable-warning=UNDICI-EHPA --watch src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node --disable-warning=ExperimentalWarning scripts/probe.ts",
    "amostra": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/amostra.ts",
    "latencia": "node --disable-warning=ExperimentalWarning scripts/latencia.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
